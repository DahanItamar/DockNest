{
  "name": "docknest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-web.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm test",
    "setup": "node scripts/setup.js",
    "brand:export": "node scripts/export-brand.js",
    "test:browser": "node scripts/smoke-browser.js",
    "test:integration": "node scripts/integration-linux.js",
    "test:dashboard": "node scripts/dashboard-browser.js",
    "test:servers": "node scripts/servers-browser.js",
    "test:rebrand": "node scripts/rebrand-browser.js",
    "test:pagination": "node scripts/pagination-browser.js",
    "test:maintenance": "node scripts/maintenance-browser.js",
    "maintenance:export": "node scripts/export-maintenance-assets.js",
    "test:design": "node scripts/berry-browser.js",
    "docs:screenshots": "node scripts/readme-screenshots.js",
    "test:health": "node scripts/system-health-browser.js",
    "audit:repo": "node scripts/audit-repository.js",
    "test:theme": "node scripts/theme-browser.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@tabler/icons-react": "^3.48.0",
    "chart.js": "^4.5.1",
    "cron-parser": "^5.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ssh2": "^1.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
